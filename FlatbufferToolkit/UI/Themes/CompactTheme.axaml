<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="using:AvaloniaEdit"
        xmlns:local="using:FlatbufferToolkit.UI.Controls">
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource ToolkitUIFont}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="MinWidth" Value="22" />
  </Style>
  <Style Selector="Button.tab-close">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="MinHeight" Value="22" />
  </Style>
  <Style Selector="Menu">
    <Setter Property="Background" Value="{DynamicResource ToolkitBackground}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="MinHeight" Value="22" />
  </Style>
  <Style Selector="TabItem">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="MinHeight" Value="26" />
  </Style>
  <Style Selector="TextBlock.tab-label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="TextBlock.pane-header">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="Background" Value="{DynamicResource ToolkitBackground}" />
  </Style>
  <Style Selector="TreeView">
    <Setter Property="Background" Value="{DynamicResource ToolkitPanelBackground}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector=":is(editor|TextEditor)">
    <Setter Property="FontFamily" Value="{DynamicResource ToolkitMonospaceFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="local|HexView">
    <Setter Property="Background" Value="{DynamicResource ToolkitPanelBackground}" />
    <Setter Property="FontFamily" Value="{DynamicResource ToolkitMonospaceFont}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Border.inspector-cell">
    <Setter Property="BorderBrush" Value="{DynamicResource ToolkitSeparator}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="MinHeight" Value="21" />
    <Setter Property="Padding" Value="5,2" />
  </Style>
</Styles>
