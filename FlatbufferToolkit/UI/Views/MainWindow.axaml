<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:FlatbufferToolkit.UI.Views"
        x:Class="FlatbufferToolkit.UI.Views.MainWindow"
        Background="{DynamicResource ToolkitBackground}"
        Title="Flatbuffer Toolkit" Width="1400" Height="900" MinWidth="900" MinHeight="600">
  <Grid RowDefinitions="Auto,*,3,110,Auto">
    <Menu>
      <MenuItem Header="_File">
        <MenuItem Header="_Open binary…" Click="OpenClick" InputGesture="Ctrl+O" />
        <MenuItem Header="Open _schema…" Click="OpenSchemaClick" />
        <MenuItem Header="_Save schema as…" Click="SaveSchemaClick" InputGesture="Ctrl+S" />
        <Separator />
        <MenuItem Header="_Close tab" Click="CloseTabClick" InputGesture="Ctrl+W" />
        <MenuItem Header="E_xit" Click="ExitClick" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem x:Name="LineNumbersItem" Header="Line numbers" ToggleType="CheckBox" IsChecked="True" Click="LineNumbersClick" />
        <MenuItem x:Name="InspectorItem" Header="Data inspector" ToggleType="CheckBox" Click="InspectorClick" />
      </MenuItem>
      <MenuItem Header="_Run" Click="RunClick" InputGesture="F5" />
    </Menu>
    <Grid Grid.Row="1">
      <views:EditorView x:Name="EmptyEditor" />
      <TabControl x:Name="Tabs" IsVisible="False" SelectionChanged="TabSelectionChanged" />
    </Grid>
    <GridSplitter Background="{DynamicResource ToolkitSeparator}" Grid.Row="2" ResizeDirection="Rows" VerticalAlignment="Stretch" />
    <TextBox Background="{DynamicResource ToolkitPanelBackground}" x:Name="Output" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
             FontFamily="{DynamicResource ToolkitMonospaceFont}" FontSize="12"
             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
    <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" Margin="6,2">
      <TextBlock x:Name="Status" Text="Ready" VerticalAlignment="Center" />
      <TextBlock x:Name="ProgressText" Grid.Column="1" Margin="20,0" VerticalAlignment="Center" HorizontalAlignment="Right" />
      <ProgressBar x:Name="ProgressBar" Grid.Column="2" Width="140" Height="10" Maximum="1" />
    </Grid>
  </Grid>
</Window>
