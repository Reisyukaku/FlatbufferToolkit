<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:FlatbufferToolkit.UI.Controls"
             xmlns:core="using:FlatbufferToolkit"
             x:Class="FlatbufferToolkit.UI.Views.EditorView">
  <Grid ColumnDefinitions="1.2*,3,*,Auto">
    <Grid RowDefinitions="1.2*,3,*">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <local:HexView x:Name="Hex" MinWidth="620" />
      </ScrollViewer>
      <GridSplitter Background="{DynamicResource ToolkitSeparator}" Grid.Row="1" ResizeDirection="Rows" VerticalAlignment="Stretch" />
      <Grid Grid.Row="2" RowDefinitions="Auto,*">
        <TextBlock Text="Parsed structure" Classes="pane-header" />
        <TreeView x:Name="Structure" Grid.Row="1" SelectionChanged="StructureSelectionChanged">
          <TreeView.ItemTemplate>
            <TreeDataTemplate DataType="core:InspectionNode" ItemsSource="{Binding Children}" x:DataType="core:InspectionNode">
              <TextBlock Text="{Binding Text}" ToolTip.Tip="{Binding ToolTipText}" />
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Grid>
    </Grid>
    <GridSplitter Background="{DynamicResource ToolkitSeparator}" Grid.Column="1" ResizeDirection="Columns" HorizontalAlignment="Stretch" />
    <Grid Grid.Column="2" RowDefinitions="Auto,*">
      <TextBlock Text="FlatBuffers schema" Classes="pane-header" />
      <local:SchemaEditor x:Name="SchemaText" Background="{DynamicResource ToolkitPanelBackground}" Grid.Row="1" />
    </Grid>
    <Border x:Name="InspectorPanel" Grid.Column="3" BorderThickness="1,0,0,0"
            BorderBrush="{DynamicResource ToolkitSeparator}" Width="230">
      <local:DataInspector x:Name="Inspector" />
    </Border>
  </Grid>
</UserControl>
